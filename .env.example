# ComputeDash keeps sparkDash's SPARKDASH_* variable names for upstream compatibility.
# `npm run setup` copies this file to .env and adds a random SPARKDASH_TOKEN.
PORT=5555
# Listen address. Keep loopback and publish with Tailscale Serve (docs/REMOTE-ACCESS.md).
# A non-loopback bind (e.g. 0.0.0.0) refuses to start without SPARKDASH_TOKEN.
BIND_HOST=127.0.0.1
# Access token. Without it, a browser on this machine can do everything, while
# requests through Tailscale Serve or a reverse proxy can only read (changes get
# 403 token_required). With it, changes and proxied reads need the token; the
# browser asks once and remembers it. Model control (Models page) always needs it.
# Generate one with `npm run setup`, or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SPARKDASH_TOKEN=
# Not recommended: start a non-loopback bind with no token (open to the network).
# SPARKDASH_ALLOW_OPEN_REMOTE=1
# Not recommended: allow Models page control without a token (loopback-only, single user).
# SPARKDASH_FLEET_ALLOW_NO_TOKEN=1
# Pages allowed to embed the dashboard in a frame: space-separated origins (CSP
# frame-ancestors; commas are rejected). Default 'none'.
# Example for a Home Assistant iframe card showing /kiosk:
# SPARKDASH_FRAME_ANCESTORS=https://homeassistant.tailnet.ts.net
# Extra browser origins allowed to call the API (comma-separated, full
# scheme://host:port). Same-origin pages, this machine's names and Tailscale
# Serve need nothing here.
# SPARKDASH_ALLOWED_ORIGINS=https://dash.example.com
# Key that encrypts stored credentials (SSH passwords, LLM API keys, alert webhook
# URLs) in config/sparks-secrets.json. A passphrase or 64 hex characters.
# Unset: a key is generated in config/.secrets-key. Setting it here keeps the key out
# of config/ (backups of config/ then hold only ciphertext). To move an existing key,
# copy the contents of config/.secrets-key here before removing that file.
# SPARKDASH_SECRETS_KEY=
LLM_PORT=8888
# Optional sanitized inference activity (disabled unless a URL is supplied).
# URL must use an explicit loopback/RFC1918 IP literal, with no credentials/query.
# Labels are approved non-secret display names, NOT API keys. No source auth is sent.
# SPARKDASH_INFERENCE_ACTIVITY_URL=http://127.0.0.1:9001/activity
# SPARKDASH_INFERENCE_ACTIVITY_LABELS=service-a,user-1
# Collector cadence follows Settings -> Poll interval. Setting one of these in the
# server's environment pins that domain instead (an explicitly set value wins).
# POLL_INTERVAL_GPU=2000
# POLL_INTERVAL_CPU=2000
# POLL_INTERVAL_NETWORK=2000
# POLL_INTERVAL_LLM=2000
# POLL_INTERVAL_BANDWIDTH=2000
POLL_INTERVAL_STORAGE=5000
# Optional: ssh -i path inside the container when the key is not a default OpenSSH name.
# The mounted private key must be mode 600 on the host.
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# Reuse authenticated SSH transports for remote polling. Set to 0 to disable.
SSH_CONTROL_PERSIST_SECONDS=60
# Benchmarks allowed to run at once across the fleet (1-32). Each unit still runs one at a time.
# MAX_ACTIVE_BENCH_JOBS=2
# One-off Remote benchmark hosts (Decode / Prefill / Quality "Remote" target) must be listed here, comma separated.
# SPARKDASH_BENCH_HOSTS=my-box.tailnet.ts.net
# Harness occupancy helpers. Loopback is always allowed. Add other helper hostnames here.
# SPARKDASH_HELPER_HOSTS=mac.tailnet.ts.net
# OCCUPANCY_POLL_MS=15000
# Cost compare: opt-in daily refresh of the hosted-model price catalog from
# raw.githubusercontent.com (community litellm list). While 0, the page serves
# the last catalog persisted at MODEL_PRICES_JSON_PATH and makes no requests.
# MODEL_PRICES_FETCH=1
# Password for the MQTT broker configured in Settings → MQTT (the URL and username
# live in settings.json). Publishing is opt-in and does nothing until enabled.
# SPARKDASH_MQTT_PASSWORD=hunter2
# Opt-in API Keys page (Settings → API Keys): the host-side bridge's unix socket and the
# token it expects. Both are read once at startup and never stored in settings.json.
# SPARKDASH_APIKEYS_BRIDGE_SOCKET=/run/sparkdash-apikeys/bridge.sock
# SPARKDASH_APIKEYS_BRIDGE_TOKEN=change-me
# Optional Mac runtime control; use the same private token on the Mac user agent.
# SPARKDASH_MAC_CONTROL_TOKEN_FILE=/app/config/mac-control-token
